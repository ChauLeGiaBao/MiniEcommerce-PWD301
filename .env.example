
# MiniEcommerce PWD301 - Environment Template
# Copy this file to .env and replace the placeholder secrets.

# Flask
SECRET_KEY=replace-with-a-long-random-secret-key

# JWT Authentication
JWT_SECRET_KEY=replace-with-another-long-random-jwt-secret-key

# Database for local development
DATABASE_URL=sqlite:///dev.db

# Flask configuration
FLASK_DEBUG=0
